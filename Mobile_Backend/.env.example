# Copy this file to .env and fill in real values. Never commit .env.

# development | production
ENVIRONMENT=development

# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/language_tutor

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
# 1440 minutes = 1 day
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed to call the API (Expo web runs on 8081).
# Native iOS/Android apps are not affected by CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
